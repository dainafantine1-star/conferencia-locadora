# Gere segredos aleatórios próprios. Nunca publique este arquivo com valores reais.
AUTH_SECRET=
APP_ENCRYPTION_KEY=
AUTH_URL=http://localhost:3000

# Vazio usa PGlite local. Em produção, informe Postgres e configure TLS na URL.
DATABASE_URL=
PGLITE_DIR=.data/pglite
STORAGE_DIR=storage
BACKUP_DIR=storage/backups
STORAGE_PROVIDER=local
# Para Supabase Storage, use STORAGE_PROVIDER=supabase e buckets privados.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=detali-files
SUPABASE_BACKUP_BUCKET=detali-backups
CRON_SECRET=
# Hosts autorizados para conexão WAHA. Separe por vírgulas; não inclua protocolo.
WAHA_ALLOWED_HOSTS=
TRUST_PROXY=0
NEXT_PUBLIC_DEMO_MODE=0

# Somente para a criação inicial com npm run company:create. Remova após o uso.
COMPANY_NAME=
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Uso administrativo único: npm run platform:admin. Remova depois de conceder acesso.
PLATFORM_ADMIN_EMAIL=
